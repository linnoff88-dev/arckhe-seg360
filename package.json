{
  "name": "seg360",
  "version": "0.1.0",
  "private": true,
  "description": "Seg360 — Marketplace de Seguros contra Calamidades",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linnoff88-dev/seg360.git"
  },
  "keywords": ["insurance", "marketplace", "calamidades"],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/linnoff88-dev/seg360/issues"
  },
  "homepage": "https://github.com/linnoff88-dev/seg360#readme",
  "devDependencies": {
    "bmad-method": "^4.44.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.4.5"
  }
}
